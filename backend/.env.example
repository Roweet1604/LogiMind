# Local development settings, read by start-dev.bat (repository root) and by the optional backend npm scripts.
# Copy to backend/.env and fill in. backend/.env is git-ignored: never commit it, never paste API keys here.
# (The .env.example in the repository root is for Docker Compose and uses Docker-only values.)

# Signs driver links (at least 32 characters) so links keep working after a restart. Generate one with:
#   %TEMP%\lmv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(48))"
LOGIMIND_DRIVER_LINK_SECRET=

# The deployed ops console allowed to call this API (CORS), e.g. https://your-app.vercel.app (no trailing slash needed).
FRONTEND_URL=

# Used when you start the API by hand. start-dev.bat always uses external, because it also opens a worker window.
# inline = the API runs the solver jobs itself (no worker); external = a separate worker runs them.
LOGIMIND_WORKER=inline

# Leave empty to use the default SQLite file experiments/results/api_data/logimind.db (API and tenant tool agree).
LOGIMIND_DATABASE_URL=

# Copilot model. "ollama" (default: local and free, used only if Ollama is running), "groq" or "gemini" (optional
# hosted free tiers, decision 0032; they need a key below), or "none".
LOGIMIND_LLM_PROVIDER=ollama

# Hosted copilot providers (optional). Put the key ONLY here: backend\.env is git-ignored. Never commit, paste or share
# a key; if one leaks, delete it in the provider's console and make a new one. The model name is required too
# (see README, "Copilot model"). Or paste a key in the console: Copilot settings (decision 0033).
GROQ_API_KEY=
GROQ_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Demo mode (decision 0029): start-dev.bat sets it to 1 (demo tenant with synthetic plans; the console signs in by
# itself; local only). Set it to 0 here to start without it. Never set it on a server.
LOGIMIND_DEMO_MODE=
