# Copy to .env (never commit .env) and fill in the two required values.
# Docker Compose reads it; see docker-compose.yml and README "Docker Compose (UNTESTED)".

# Required. Database password for the Compose Postgres. Pick your own; no default on purpose.
POSTGRES_PASSWORD=

# Required. Signs driver links; at least 32 characters. Generate one, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
LOGIMIND_DRIVER_LINK_SECRET=

# Base URL of the driver app used inside driver links.
LOGIMIND_DRIVER_APP_URL=http://localhost:8081

# Road distances. Empty: distance_source="osrm" uses the flagged straight-line fallback.
# With the "osrm" profile running:  LOGIMIND_OSRM_URL=http://osrm:5000
LOGIMIND_OSRM_URL=

# Copilot model through a local Ollama on the host (free, offline). "none" turns the copilot off.
LOGIMIND_LLM_PROVIDER=ollama
LOGIMIND_OLLAMA_URL=http://host.docker.internal:11434
LOGIMIND_OLLAMA_MODEL=llama3.2:3b
